<!-- Podcasts, Radio and audio player texts (English). -->
<resources>
	<!-- Name of the long-press action on list rows («Double-tap and hold for more actions») -->
	<string name="audio_mas_acciones">More actions</string>
	<!-- Player: volume boost of an episode whose podcast has its own volume -->
	<string name="audio_refuerzo_podcast">Volume boost for this podcast</string>
	<!-- Radio: wait dialog while importing an M3U or PLS list -->
	<string name="audio_importando">Importing stations…</string>
	<!-- Radio: wait dialog while saving a recording to the library -->
	<string name="audio_guardando_biblioteca">Saving the recording to the library…</string>
