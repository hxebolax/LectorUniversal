<?xml version="1.0" encoding="utf-8"?>
<!-- Pestaña Compartidos de Ajustes: lo que llega de otras apps o de internet -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto">
	<Preference
		android:key="ir_voz_compartidos"
		android:title="@string/voz_compartidos_titulo"
		android:summary="@string/aj_voz_compartidos_desc" />
	<ListPreference
		android:key="comp_destino"
		android:title="@string/aj_comp_destino"
		android:entries="@array/comp_destino_nombres"
		android:entryValues="@array/comp_destino_valores"
		android:defaultValue="compartidos"
		app:useSimpleSummaryProvider="true" />
	<ListPreference
		android:key="comp_al_recibir"
		android:title="@string/aj_comp_al_recibir"
		android:entries="@array/comp_al_recibir_nombres"
		android:entryValues="@array/comp_al_recibir_valores"
		android:defaultValue="abrir"
		app:useSimpleSummaryProvider="true" />
	<ListPreference
		android:key="comp_borrar_leidos"
		android:title="@string/aj_comp_borrar_leidos"
		android:entries="@array/comp_borrar_nombres"
		android:entryValues="@array/comp_borrar_valores"
		android:defaultValue="0"
		app:useSimpleSummaryProvider="true" />
	<Preference
		android:key="comp_explicacion"
		android:selectable="false"
		android:summary="@string/aj_comp_borrar_leidos_desc" />
	<Preference
		android:key="ir_acciones_compartidos"
		android:title="@string/aj_acciones_compartidos"
		android:summary="@string/aj_acciones_compartidos_desc" />
</PreferenceScreen>
