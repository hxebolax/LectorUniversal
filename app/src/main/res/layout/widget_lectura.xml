<?xml version="1.0" encoding="utf-8"?>
<!-- Widget: libro que se está leyendo, seguir leyendo y leer en voz alta -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/fondo_widget"
	android:gravity="center_vertical"
	android:orientation="horizontal"
	android:padding="8dp">

	<LinearLayout
		android:id="@+id/widget_abrir"
		android:layout_width="0dp"
		android:layout_height="match_parent"
		android:layout_weight="1"
		android:gravity="center_vertical"
		android:minHeight="48dp"
		android:orientation="vertical"
		android:paddingHorizontal="8dp">

		<TextView
			android:id="@+id/widget_titulo"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="2"
			android:textColor="#FFFFFF"
			android:textSize="16sp"
			android:textStyle="bold" />

		<TextView
			android:id="@+id/widget_detalle"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:textColor="#DDDDDD"
			android:textSize="13sp" />
	</LinearLayout>

	<ImageButton
		android:id="@+id/widget_voz"
		android:layout_width="56dp"
		android:layout_height="56dp"
		android:background="@android:color/transparent"
		android:src="@drawable/ic_reproducir"
		android:tint="#FFFFFF" />
</LinearLayout>
