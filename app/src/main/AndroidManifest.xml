<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools">

	<!-- Abrir páginas web y buscar actualizaciones -->
	<!-- La IA del móvil (Gemini Nano) pide Android 8; en Android 7 la app no la ofrece -->
	<uses-sdk tools:overrideLibrary="com.google.mlkit.genai.prompt,com.google.mlkit.genai.common" />

	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Escanear hojas con la cámara (se pide al usarlo) -->
	<uses-permission android:name="android.permission.CAMERA" />
	<uses-feature android:name="android.hardware.camera.any" android:required="false" />
	<uses-permission android:name="android.permission.WAKE_LOCK" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- Lectura en voz alta y audiolibros con la pantalla apagada -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
	<!-- Exportar un libro a audio en segundo plano -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
	<!-- Instalar las actualizaciones descargadas del servidor (lo confirma el usuario) -->
	<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
	<!-- Radio: despertador (alarmas exactas, como un reloj despertador) y volver a ponerlas al reiniciar -->
	<uses-permission android:name="android.permission.USE_EXACT_ALARM" />
	<uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
	<!-- Radio: el despertador se ve aunque el móvil esté bloqueado -->
	<uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
	<!-- Radio: avisar antes de escuchar con datos móviles -->
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<!-- Pedir que el ahorro de batería no corte la lectura con la pantalla apagada (lo confirma el usuario) -->
	<uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

	<!-- Motores de voz instalados -->
	<queries>
		<intent>
			<action android:name="android.intent.action.TTS_SERVICE" />
		</intent>
		<!-- Radio: ecualizador del sistema -->
		<intent>
			<action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
		</intent>
		<!-- Radio: buscar una canción en internet -->
		<intent>
			<action android:name="android.intent.action.WEB_SEARCH" />
		</intent>
	</queries>

	<application
		android:name=".LectorApp"
		android:allowBackup="true"
		android:usesCleartextTraffic="true"
		android:dataExtractionRules="@xml/respaldo_reglas"
		android:fullBackupContent="@xml/respaldo"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:roundIcon="@mipmap/ic_launcher"
		android:supportsRtl="true"
		android:theme="@style/Tema.Lector"
		tools:targetApi="35">

		<activity
			android:name=".ui.PrincipalActivity"
			android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard"
			android:exported="true"
			android:launchMode="singleTop"
			android:windowSoftInputMode="adjustResize">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
			<!-- "Abrir con" desde otras apps: por tipo de archivo -->
			<intent-filter android:label="@string/app_name">
				<action android:name="android.intent.action.VIEW" />
				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="android.intent.category.BROWSABLE" />
				<data android:scheme="content" />
				<data android:scheme="file" />
				<data android:mimeType="application/epub+zip" />
				<data android:mimeType="application/pdf" />
				<data android:mimeType="application/msword" />
				<data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
				<data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
				<data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
				<data android:mimeType="application/vnd.oasis.opendocument.text" />
				<data android:mimeType="application/vnd.oasis.opendocument.presentation" />
				<data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
				<data android:mimeType="application/rtf" />
				<data android:mimeType="text/rtf" />
				<data android:mimeType="text/plain" />
				<data android:mimeType="text/html" />
				<data android:mimeType="text/markdown" />
				<data android:mimeType="text/x-markdown" />
				<data android:mimeType="text/csv" />
				<data android:mimeType="application/xhtml+xml" />
				<data android:mimeType="application/x-fictionbook+xml" />
				<data android:mimeType="application/x-fictionbook" />
				<data android:mimeType="application/x-mobipocket-ebook" />
				<data android:mimeType="application/vnd.amazon.ebook" />
				<data android:mimeType="application/vnd.ms-htmlhelp" />
				<data android:mimeType="application/x-chm" />
				<data android:mimeType="application/zip" />
				<data android:mimeType="application/x-zip-compressed" />
				<data android:mimeType="audio/*" />
				<data android:mimeType="application/x-mpegurl" />
			</intent-filter>
			<!-- Archivos sin tipo reconocido (algunos gestores de archivos mandan octet-stream) -->
			<intent-filter android:label="@string/app_name">
				<action android:name="android.intent.action.VIEW" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:scheme="content" />
				<data android:scheme="file" />
				<data android:mimeType="application/octet-stream" />
				<data android:host="*" />
				<data android:pathPattern=".*\\.epub" />
				<data android:pathPattern=".*\\.mobi" />
				<data android:pathPattern=".*\\.azw3" />
				<data android:pathPattern=".*\\.fb2" />
				<data android:pathPattern=".*\\.m4b" />
				<data android:pathPattern=".*\\.chm" />
				<data android:pathPattern=".*\\.md" />
			</intent-filter>
			<!-- Compartir texto, un enlace o archivos con la app -->
			<intent-filter android:label="@string/app_name">
				<action android:name="android.intent.action.SEND" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:mimeType="text/plain" />
			</intent-filter>
			<intent-filter android:label="@string/app_name">
				<action android:name="android.intent.action.SEND" />
				<action android:name="android.intent.action.SEND_MULTIPLE" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:mimeType="application/*" />
				<data android:mimeType="audio/*" />
				<data android:mimeType="text/*" />
			</intent-filter>
		</activity>

		<activity
			android:name=".lectura.LectorActivity"
			android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation"
			android:exported="false"
			android:launchMode="singleTop"
			android:parentActivityName=".ui.PrincipalActivity" />
		<activity
			android:name=".audio.ReproductorActivity"
			android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation"
			android:exported="false"
			android:launchMode="singleTop"
			android:parentActivityName=".ui.PrincipalActivity" />
		<activity
			android:name=".rss.RssActivity"
			android:exported="false"
			android:label="@string/noticias" />
		<!-- Compartir una dirección desde otra app: suscribirse en Noticias o en Podcasts -->
		<activity-alias
			android:name=".rss.AnadirANoticias"
			android:exported="true"
			android:label="@string/anadir_a_noticias"
			android:targetActivity=".rss.RssActivity">
			<intent-filter>
				<action android:name="android.intent.action.SEND" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:mimeType="text/plain" />
			</intent-filter>
		</activity-alias>
		<activity-alias
			android:name=".podcast.AnadirAPodcasts"
			android:exported="true"
			android:label="@string/anadir_a_podcasts"
			android:targetActivity=".podcast.PodcastActivity">
			<intent-filter>
				<action android:name="android.intent.action.SEND" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:mimeType="text/plain" />
			</intent-filter>
		</activity-alias>
		<activity
			android:name=".podcast.PodcastActivity"
			android:exported="false"
			android:label="@string/podcasts" />
		<activity
			android:name=".radio.RadioActivity"
			android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard"
			android:exported="false"
			android:label="@string/radio"
			android:launchMode="singleTop"
			android:windowSoftInputMode="adjustResize" />
		<!-- Compartir la dirección de una emisora desde otra app: añadirla a la Radio -->
		<activity-alias
			android:name=".radio.AnadirARadio"
			android:exported="true"
			android:label="@string/anadir_a_radio"
			android:targetActivity=".radio.RadioActivity">
			<intent-filter>
				<action android:name="android.intent.action.SEND" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:mimeType="text/plain" />
			</intent-filter>
		</activity-alias>
		<activity
			android:name=".radio.RadioReproductorActivity"
			android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard"
			android:exported="false"
			android:launchMode="singleTop"
			android:parentActivityName=".radio.RadioActivity" />
		<activity
			android:name=".podcast.PodcastFichaActivity"
			android:exported="false" />
		<activity
			android:name=".rss.SesionActivity"
			android:exported="false" />
		<activity
			android:name=".ui.ListaActivity"
			android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard"
			android:exported="false"
			android:windowSoftInputMode="stateHidden|adjustResize" />
		<activity
			android:name=".ui.TextoActivity"
			android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard"
			android:exported="false" />
		<activity
			android:name=".ui.AjustesActivity"
			android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard"
			android:exported="false"
			android:windowSoftInputMode="adjustResize" />
		<activity
			android:name=".ui.EstadisticasActivity"
			android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard"
			android:exported="false" />
		<activity
			android:name=".catalogo.NavegadorBibliotecaActivity"
			android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard"
			android:exported="false"
			android:windowSoftInputMode="adjustResize" />
		<activity
			android:name=".ocr.EscanerActivity"
			android:exported="false"
			android:screenOrientation="unspecified" />
		<activity
			android:name=".ui.ImportarOpmlActivity"
			android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard"
			android:exported="false" />
		<activity
			android:name=".ui.AccionesTalkBackActivity"
			android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard"
			android:exported="false" />
		<activity
			android:name=".ui.PronunciacionActivity"
			android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard"
			android:exported="false"
			android:windowSoftInputMode="adjustResize" />

		<!-- Lectura en voz alta en segundo plano (notificación, bloqueo, auriculares) -->
		<service
			android:name=".voz.ServicioVoz"
			android:exported="true"
			android:foregroundServiceType="mediaPlayback"
			tools:ignore="ExportedService">
			<intent-filter>
				<action android:name="androidx.media3.session.MediaSessionService" />
			</intent-filter>
		</service>

		<!-- Audiolibros y DAISY en segundo plano -->
		<service
			android:name=".audio.ServicioAudio"
			android:exported="true"
			android:foregroundServiceType="mediaPlayback"
			tools:ignore="ExportedService">
			<intent-filter>
				<action android:name="androidx.media3.session.MediaSessionService" />
			</intent-filter>
		</service>

		<!-- Radio: grabar una emisora en segundo plano -->
		<service
			android:name=".radio.ServicioGrabacion"
			android:exported="false"
			android:foregroundServiceType="dataSync" />

		<!-- Radio: despertador, grabaciones programadas y sus botones (Apagar, Posponer) -->
		<receiver
			android:name=".radio.RadioReceptorAlarma"
			android:exported="false" />
		<receiver
			android:name=".radio.RadioReceptorArranque"
			android:exported="false">
			<intent-filter>
				<action android:name="android.intent.action.BOOT_COMPLETED" />
				<action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
				<action android:name="android.intent.action.TIME_SET" />
				<action android:name="android.intent.action.TIMEZONE_CHANGED" />
			</intent-filter>
		</receiver>

		<!-- Exportar a audio -->
		<service
			android:name=".voz.ServicioExportar"
			android:exported="false"
			android:foregroundServiceType="dataSync" />

		<!-- IA descargada: usa la tarjeta gráfica si el móvil la ofrece -->
		<uses-native-library android:name="libOpenCL.so" android:required="false" />
		<uses-native-library android:name="libvndksupport.so" android:required="false" />

		<!-- Botones del aviso de artículos nuevos: marcar como leído y añadir a favoritos -->
		<receiver
			android:name=".rss.RssReceptorAvisos"
			android:exported="false" />

		<!-- Widget de la pantalla de inicio: seguir leyendo y leer en voz alta -->
		<receiver
			android:name=".widget.WidgetLectura"
			android:exported="false"
			android:label="@string/widget_nombre">
			<intent-filter>
				<action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
			</intent-filter>
			<meta-data
				android:name="android.appwidget.provider"
				android:resource="@xml/widget_lectura" />
		</receiver>

		<!-- Idioma de la app elegido en Ajustes (se guarda solo en Android 12 y anteriores) -->
		<service
			android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
			android:enabled="false"
			android:exported="false">
			<meta-data
				android:name="autoStoreLocales"
				android:value="true" />
		</service>

		<provider
			android:name="androidx.core.content.FileProvider"
			android:authorities="${applicationId}.archivos"
			android:exported="false"
			android:grantUriPermissions="true">
			<meta-data
				android:name="android.support.FILE_PROVIDER_PATHS"
				android:resource="@xml/rutas_archivos" />
		</provider>
	</application>
</manifest>
