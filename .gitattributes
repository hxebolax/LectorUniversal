# Texto: se guarda tal cual (los fuentes usan LF; los .bat y .ps1, CRLF para Windows)
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios: nunca se tocan los finales de línea
